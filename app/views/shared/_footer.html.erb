<footer class="site-footer">

  <%# ── Two calls, built the same way, each on its own band: painting on the left, content on the right ── %>
  <div class="footer-call footer-call--white">
    <div class="container">
      <div class="footer-call-grid">
        <figure class="footer-call-figure">
          <%= image_tag "footer-fragonard-lettre.jpg", alt: "", loading: "lazy", class: "footer-call-painting" %>
          <figcaption>La Lettre d’amour (vers 1770) — Jean-Honoré Fragonard</figcaption>
        </figure>

        <div class="footer-call-inner">
          <h2 class="footer-call-title">
            <span class="footer-call-title-line">
              <span class="footer-call-picto footer-call-picto--envelope" aria-hidden="true"></span>
              Recevoir les prochaines Lettres
            </span>
          </h2>
          <%= render "shared/subscribe_form" %>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-call footer-call--rose">
    <div class="container">
      <div class="footer-call-grid">
        <figure class="footer-call-figure">
          <%= image_tag "footer-renoir-roses.jpg", alt: "", loading: "lazy", class: "footer-call-painting" %>
          <figcaption>Roses dans un vase vert (1911) — Auguste Renoir</figcaption>
        </figure>

        <div class="footer-call-inner">
          <h2 class="footer-call-title">
            <span class="footer-call-title-line">
              <span class="footer-call-picto footer-call-picto--pen" aria-hidden="true"></span>
              Une œuvre d’art vous a touchée&nbsp;?
            </span>
          </h2>
          <p>Vous aussi vous souhaitez partager un coup de cœur ❤, un enthousiasme, une émotion artistique&nbsp;? La fois prochaine, nous pourrions savourer ensemble votre œuvre d’art&nbsp;🌟</p>
          <p>Écrivez-nous à <a href="mailto:bonjour@entretouteslesfemmes.fr" class="footer-call-link">bonjour@entretouteslesfemmes.fr</a></p>
        </div>
      </div>
    </div>
  </div>

  <%# ── Main section : brand + links ── %>
  <div class="footer-main">
    <div class="container">
      <%# One line: brand on the left, links on the right (stacked on phones) %>
      <div class="footer-main-row">
        <p class="footer-brand-title">Entre toutes <em>les femmes</em></p>

        <nav class="footer-links">
          <%= link_to about_path, class: "footer-theme-link" do %><span>L’auteur</span><% end %>
          <%= link_to newsletters_path, class: "footer-theme-link" do %><span>Toutes les lettres</span><% end %>
          <%= link_to contact_path, class: "footer-theme-link" do %><span>Contact</span><% end %>
        </nav>
      </div>

    </div>
  </div>

  <%# ── Bottom bar ── %>
  <div class="footer-bottom">
    <div class="container">
      <span>&copy; <%= Date.today.year %> Entre toutes les femmes</span>
      <span class="footer-bottom-sep" aria-hidden="true">·</span>
      <%= link_to "Mentions légales", legal_path %>
      <span class="footer-bottom-sep" aria-hidden="true">·</span>
      <%= link_to "Confidentialité", privacy_path %>
    </div>
  </div>

</footer>
