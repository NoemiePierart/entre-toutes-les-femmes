<footer class="site-footer">

  <%# ── Subscribe card (hidden on the contact page) ── %>
  <% unless current_page?(contact_path) %>
  <%# On the homepage the last rubrique band is pink, so the subscribe area switches to white %>
  <div class="footer-subscribe-card-wrap <%= current_page?(root_path) ? "footer-subscribe-card-wrap--white" : "secondary-background" %>">
    <div class="container">

      <%# Part 1 — Formulaire (blue border) %>
      <div class="footer-subscribe-card">
        <h2 class="footer-subscribe-card-title">
          <i class="fa-regular fa-envelope"></i> Recevoir la lettre
        </h2>
        <p class="footer-subscribe-card-tagline">Chaque dimanche, directement dans votre boîte mail.</p>
        <%= form_with url: subscribe_path, class: "footer-subscribe-form" do |f| %>
          <%= f.email_field :email, placeholder: "Votre adresse e-mail", required: true %>
          <%= f.submit "S'abonner", class: "btn btn-primary" %>
        <% end %>
      </div>

      <hr class="footer-subscribe-divider">

      <%# Part 2 — Vous aussi %>
      <div class="footer-subscribe-card-banner">
        <p class="footer-subscribe-card-banner-title">Une œuvre vous a touchée ?</p>
        <p class="footer-subscribe-card-banner-body">Vous aussi vous souhaitez partager un coup de cœur ❤, un enthousiasme, une émotion artistique&nbsp;?</p>
        <p class="footer-subscribe-card-banner-body">La semaine prochaine, nous pourrions savourer ensemble votre œuvre d'art&nbsp;🌟</p>
        <p class="footer-subscribe-card-banner-body">Partagez vos idées en nous écrivant à <a href="mailto:bonjour@entretouteslesfemmes.fr" class="footer-subscribe-card-link">bonjour@entretouteslesfemmes.fr</a></p>
      </div>

    </div>
  </div>
  <% end %>

  <%# ── Main section : brand + categories ── %>
  <div class="footer-main">
    <div class="container">
      <div class="row g-5 align-items-start">

        <div class="col-12 col-md-5">
          <p class="footer-brand-title">Entre toutes <em>les femmes</em></p>
          <p class="footer-brand-tagline">Nourrir, encourager, éclairer</p>
        </div>

        <div class="col-12 col-md-7">
          <div class="row g-4">
            <div class="col-6">
              <ul class="footer-theme-list">
                <% @nav_themes&.each do |theme| %>
                  <li><%= link_to theme_path(theme), class: "footer-theme-link" do %><span><%= theme.name %></span><% end %></li>
                <% end %>
              </ul>
            </div>
            <div class="col-6">
              <%= link_to about_path, class: "footer-theme-link" do %><span>À propos</span><% end %>
              <%= link_to newsletters_path, class: "footer-theme-link" do %><span>Toutes les lettres</span><% end %>
              <%= link_to contact_path, class: "footer-theme-link" do %><span>Contact</span><% end %>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>

  <%# ── Bottom bar ── %>
  <div class="footer-bottom">
    <div class="container">
      <span>&copy; <%= Date.today.year %> Entre toutes les femmes</span>
    </div>
  </div>

</footer>
