<% content_for :title, @theme.name %>
<% content_for :description, @theme.description.presence || "Découvrez les articles de la rubrique #{@theme.name} — Entre toutes les femmes." %>
<% og_image_file = "og-theme-#{@theme.name.parameterize}.png" %>
<% content_for :og_image, request.base_url + "/#{og_image_file}" if Rails.public_path.join(og_image_file).exist? %>

<div class="theme-show-page">

  <%# Hero — pleine largeur %>
  <div class="theme-show-hero-frame" <% if @theme.image.attached? %>style="background-image: url('<%= variant_url(@theme.image, resize_to_limit: [1400, 800], format: :webp) %>')"<% end %>>
    <div class="theme-show-hero-overlay"></div>
    <div class="theme-show-hero-content">
      <span class="theme-show-hero-rubrique">Rubrique</span>
      <h1 class="theme-show-hero-title"><%= @theme.name %></h1>
    </div>
  </div>

  <%# Carte flottante — description, puis la légende du tableau %>
  <% credit = @theme.image_credit if @theme.image.attached? %>
  <% if @theme.description.present? || credit %>
    <div class="theme-show-desc-wrap">
      <% if @theme.description.present? %>
        <div class="theme-show-desc-card">
          <p class="theme-show-desc-text"><%= @theme.description %></p>
        </div>
      <% end %>
      <% if credit %>
        <p class="theme-show-credit"><%= credit %></p>
      <% end %>
    </div>
  <% end %>

  <%# Posts %>
  <div class="theme-show-posts">
    <% if @posts.any? %>
      <div class="d-flex justify-content-center mb-4">
        <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
      </div>
      <%# Same cards as the homepage bands, on the rose background %>
      <div class="home-rubrique-posts theme-show-grid">
        <% @posts.each do |post| %>
          <%= link_to post, class: "home-post" do %>
            <div class="home-post-image">
              <% if post.cover_image? %>
                <%= image_tag variant_url(post.cover_image, resize_to_fill: [ 520, 390 ], format: :webp), alt: "", loading: "lazy" %>
              <% end %>
            </div>
            <div class="home-post-body">
              <h3 class="home-post-title"><%= post.display_title %></h3>
              <p class="home-post-excerpt"><%= post.excerpt %></p>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="d-flex justify-content-center mt-5">
        <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
      </div>
    <% else %>
      <p class="text-muted">Aucun article dans cette rubrique pour le moment.</p>
    <% end %>
  </div>

</div>
