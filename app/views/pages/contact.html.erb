<% content_for :title, "Contact" %>
<% content_for :description, "Écrivez-nous : une question, une suggestion ou une œuvre à partager avec Entre toutes les femmes." %>

<section class="contact-page secondary-background">
  <div class="container">
    <div class="contact-card">
      <i class="fa-regular fa-envelope contact-icon"></i>
      <h1 class="contact-title">Contact</h1>
      <p class="contact-intro">Une question, une suggestion, ou l'envie de partager une œuvre qui vous a touchée&nbsp;? C'est toujours une joie de vous lire.</p>
      <p class="contact-text">Vous pouvez nous écrire à l'adresse</p>
      <a href="mailto:bonjour@entretouteslesfemmes.fr" class="contact-email">bonjour@entretouteslesfemmes.fr</a>
      <p class="contact-outro">Nous vous répondrons avec plaisir, dans les meilleurs délais.</p>
    </div>
  </div>
</section>
