<% content_for :description, "Une lettre hebdomadaire pour nourrir, encourager et éclairer les femmes chrétiennes" %>
<% content_for :og_image, request.base_url + "/og-image.png" %>
<% content_for :head do %>
  <link rel="preload" as="image" href="<%= image_path("hero-roses-dubourg.jpg") %>">
<% end %>
<% content_for :json_ld do %>
  <script type="application/ld+json">
    <%== { "@context" => "https://schema.org", "@type" => "WebSite", "name" => "Entre toutes les femmes", "description" => "Une lettre hebdomadaire pour nourrir, encourager et éclairer les femmes chrétiennes.", "url" => root_url }.to_json %>
  </script>
<% end %>

<%# SECTION 1 — Hero %>
<section class="home-hero">
  <div class="home-hero-frame" style="background-image: url('<%= image_path("hero-roses-dubourg.jpg") %>')">
    <div class="home-hero-overlay"></div>
    <div class="home-hero-content">
      <h1 class="home-hero-title">Entre toutes<br><em>les femmes</em></h1>
      <p class="home-hero-tagline">Nourrir &nbsp;·&nbsp; Encourager &nbsp;·&nbsp; Éclairer</p>
    </div>
  </div>
  <div class="container">
    <p class="home-hero-caption">Vase de fleurs (1876) — Victoria Fantin-Latour, Centraal Museum, Utrecht</p>
  </div>
</section>

<%# SECTION 2 — Mission : the site's purpose, then one arch per rubrique %>
<section class="home-mission">
  <div class="container">
    <h2 class="home-section-title"><i class="fa-solid fa-quote-left home-section-icon"></i> Encourager les femmes chrétiennes à vivre leur féminité de manière unifiée, en leur offrant un contenu riche de sens et beau</h2>

    <div class="home-arches">
      <% @themes.each do |theme| %>
        <%= link_to theme_path(theme), class: "home-arch" do %>
          <div class="home-arch-image">
            <% if theme.image.attached? %>
              <%= image_tag variant_url(theme.image, resize_to_fill: [ 600, 660 ], format: :webp), alt: "", loading: "lazy" %>
            <% end %>
          </div>
          <span class="home-arch-caption">
            <span class="home-eyebrow">Rubrique</span>
            <span class="home-arch-name"><%= theme.name %></span>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# SECTION 3 — Rubriques : one full-width band per rubrique, alternating backgrounds,
    with a daily selection of its posts %>
<section class="home-rubriques">
  <h2 class="visually-hidden">Les rubriques</h2>

  <% @themes.each_with_index do |theme, index| %>
    <div class="home-rubrique">
      <div class="container">
        <div class="home-rubrique-inner">
          <div class="home-rubrique-intro">
            <span class="home-eyebrow">Rubrique</span>
            <h3 class="home-rubrique-title"><%= link_to theme.name, theme_path(theme) %></h3>
            <p class="home-rubrique-tagline"><%= theme.tagline.presence || theme.description %></p>
            <%= link_to "Découvrir", theme_path(theme), class: "btn-primary" %>
          </div>

          <div class="home-rubrique-posts">
            <% @selections[theme].each do |post| %>
              <%= link_to post, class: "home-post" do %>
                <div class="home-post-image">
                  <%= image_tag variant_url(post.cover_image, resize_to_fill: [ 520, 390 ], format: :webp), alt: "", loading: "lazy" %>
                </div>
                <div class="home-post-body">
                  <h4 class="home-post-title"><%= post.display_title %></h4>
                  <p class="home-post-excerpt"><%= post.excerpt %></p>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <%# The call to action closes the last band, so it shares its background %>
        <% if index == @themes.size - 1 %>
          <div class="home-rubriques-cta">
            <%= link_to "Parcourir toutes les lettres", newsletters_path, class: "btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
